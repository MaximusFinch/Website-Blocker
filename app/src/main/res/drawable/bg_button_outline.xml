<?xml version="1.0" encoding="utf-8"?>
<!-- Second-choice button: dark with an orange outline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/surface2" /><corners android:radius="16dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#33FF7A1A" /><corners android:radius="16dp" /><stroke android:width="1.5dp" android:color="@color/accent2" /></shape></item>
    <item><shape><solid android:color="@color/surface2" /><corners android:radius="16dp" /><stroke android:width="1.5dp" android:color="#B3FF8C33" /></shape></item>
</selector>
