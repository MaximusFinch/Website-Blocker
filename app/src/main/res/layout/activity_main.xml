<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Header: name and state, numbers, status pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/header_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/header_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:alpha="0.85"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- What is blocked: sites, apps, ads blocked today -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_stat"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/stat_sites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="@string/stat_sites"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stat"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/stat_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="@string/stat_apps"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stat"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/stat_ads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="@string/stat_ads"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            </LinearLayout>

            <!-- Status pills: protection (tap to pause) and Alpha mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <!-- Alpha mode status; tap shows what it means -->
                <TextView
                    android:id="@+id/alpha_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notice: accessibility off -->
        <LinearLayout
            android:id="@+id/service_card"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/service_off_title" />

            <TextView
                style="@style/CardDesc"
                android:text="@string/service_off_desc" />

            <TextView
                android:id="@+id/help"
                style="@style/CardDesc"
                android:layout_marginTop="8dp"
                android:text="@string/help" />

            <Button
                android:id="@+id/btn_service"
                style="@style/PrimaryButton"
                android:text="@string/enable_service" />
        </LinearLayout>

        <!-- Notice: blocking turned off. Only shown while off, slides away once turned on -->
        <LinearLayout
            android:id="@+id/card_enabled"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/blocking_off_title" />

            <TextView
                style="@style/CardDesc"
                android:text="@string/blocking_off_desc" />

            <Button
                android:id="@+id/btn_enable"
                style="@style/PrimaryButton"
                android:text="@string/turn_on" />
        </LinearLayout>

        <!-- Block list -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/sites_header" />

            <TextView
                style="@style/CardDesc"
                android:text="@string/sites_desc" />

            <EditText
                android:id="@+id/input_site"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/sites_hint"
                android:inputType="textUri|textMultiLine"
                android:maxLines="8"
                android:minLines="2"
                android:padding="14dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <!-- Which list the entered sites go to -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_add_always"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="@string/add_always" />

                <Button
                    android:id="@+id/btn_add_flex"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="@string/add_flex" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_add_app"
                style="@style/SecondaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/add_app" />

            <TextView
                style="@style/TileLabel"
                android:layout_width="match_parent"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="0"
                android:text="@string/lists_label" />

            <!-- Always list (collapsible) -->
            <LinearLayout
                android:id="@+id/always_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingVertical="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_bar_always" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/always_toggle_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/always_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/always_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="▾"
                    android:textColor="@color/text_dim"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/always_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- On schedule list (collapsible) -->
            <LinearLayout
                android:id="@+id/flex_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingVertical="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_bar_flex" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/flex_toggle_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/flex_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/flex_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="▾"
                    android:textColor="@color/text_dim"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/flex_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Schedule: only for the On schedule list, can always be changed -->
        <LinearLayout
            android:id="@+id/card_schedule"
            style="@style/Card">

            <Switch
                android:id="@+id/sw_schedule"
                style="@style/CardSwitch"
                android:text="@string/schedule_enabled" />

            <TextView
                style="@style/CardDesc"
                android:text="@string/schedule_desc" />

            <LinearLayout
                android:id="@+id/schedule_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TileLabel"
                        android:text="@string/from" />

                    <TextView
                        style="@style/TileLabel"
                        android:layout_marginStart="10dp"
                        android:text="@string/to" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_start"
                        style="@style/TimeTile" />

                    <Button
                        android:id="@+id/btn_end"
                        style="@style/TimeTile"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ad blocker (not protected by Alpha mode) -->
        <LinearLayout
            android:id="@+id/card_adblock"
            style="@style/Card">

            <Switch
                android:id="@+id/sw_adblock"
                style="@style/CardSwitch"
                android:text="@string/adblock_title" />

            <TextView
                style="@style/CardDesc"
                android:text="@string/adblock_desc" />

            <TextView
                android:id="@+id/adblock_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="14sp" />

            <TextView
                style="@style/CardDesc"
                android:layout_marginTop="10dp"
                android:text="@string/adblock_note"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_adblock_update"
                style="@style/SecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/adblock_update" />
        </LinearLayout>

        <!-- Alpha mode -->
        <LinearLayout
            android:id="@+id/card_alpha"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/strict_header" />

            <TextView
                android:id="@+id/strict_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="14sp" />

            <TextView
                style="@style/CardDesc"
                android:layout_marginTop="10dp"
                android:text="@string/strict_desc" />

            <Button
                android:id="@+id/btn_strict"
                style="@style/PrimaryButton"
                android:text="@string/strict_start" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="@string/version_label"
            android:textAllCaps="true"
            android:textColor="@color/text_hint"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/version"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
