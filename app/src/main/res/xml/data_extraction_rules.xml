<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer: nothing of WebBlock is copied into backups or to a new
  phone. Otherwise a backup could be edited and restored to end Alpha mode.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
